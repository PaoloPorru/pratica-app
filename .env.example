# ─── PRATICA — Environment Variables ───────────────────────────────────────
# Copy this file to .env.local and fill in the values you need.
# The app runs 100% offline without any of these.

# ─── Optional: Supabase (FREE TIER) ─────────────────────────────────────────
# Uncomment and fill to enable cloud sync/backup.
# Sign up free at https://supabase.com

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Optional: Ollama (local AI) ────────────────────────────────────────────
# Run Ollama locally: https://ollama.ai
# Default is localhost:11434 — only change if you use a custom port.

# NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
# NEXT_PUBLIC_OLLAMA_MODEL=llama3

# Supported models: llama3, mistral, gemma, phi3, qwen2
# The app falls back to the heuristic engine if Ollama is not running.

# ─── App Config (optional) ──────────────────────────────────────────────────
# NEXT_PUBLIC_APP_NAME=Pratica
# NEXT_PUBLIC_APP_VERSION=1.0.0
